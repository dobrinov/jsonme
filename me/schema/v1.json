{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/dobrinov/jsonme/main/me/schema/v1.json",
  "title": "{me}",
  "description": "A developer CV: JSON Resume plus headline, facts, highlights and two-sided expertise.",
  "type": "object",
  "required": ["basics"],
  "properties": {
    "$schema": { "type": "string" },
    "basics": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "description": "Current role, e.g. \"Development lead at Dext\"." },
        "image": { "type": "string", "description": "URL, or a path relative to the repo (e.g. avatar.jpg)." },
        "email": { "type": "string" },
        "url": { "type": "string" },
        "summary": { "type": "string" },
        "location": {
          "type": "object",
          "properties": {
            "city": { "type": "string" },
            "region": { "type": "string" },
            "countryCode": { "type": "string" },
            "country": { "type": "string" }
          }
        },
        "profiles": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": { "network": { "type": "string" }, "username": { "type": "string" }, "url": { "type": "string" } }
          }
        }
      }
    },
    "headline": {
      "type": "string",
      "maxLength": 120,
      "description": "One sentence about what you are best at. Shown large at the top."
    },
    "facts": {
      "type": "array",
      "maxItems": 4,
      "description": "Up to 4 numbers or short phrases that summarise you at a glance.",
      "items": {
        "type": "object",
        "required": ["value", "label"],
        "properties": { "value": { "type": "string", "maxLength": 48 }, "label": { "type": "string", "maxLength": 90 } }
      }
    },
    "highlights": {
      "type": "array",
      "maxItems": 3,
      "description": "Your 3 signature stories. Choosing them is part of the signal.",
      "items": {
        "type": "object",
        "required": ["title", "problem", "did", "outcome"],
        "properties": {
          "title": { "type": "string" },
          "hook": { "type": "string", "description": "One line shown on the card before it is opened." },
          "where": { "type": "string" },
          "when": { "type": "string" },
          "tags": { "type": "array", "items": { "enum": ["depth", "leadership", "product", "ai"] } },
          "problem": { "type": "string" },
          "did": { "type": "string" },
          "outcome": { "type": "string" },
          "stack": { "type": "array", "items": { "type": "string" } },
          "evidence": {
            "type": "array",
            "items": {
              "oneOf": [
                { "type": "string" },
                { "type": "object", "required": ["url"], "properties": { "url": { "type": "string" }, "label": { "type": "string" } } }
              ]
            }
          }
        }
      }
    },
    "expertise": {
      "type": "object",
      "properties": {
        "engineering": { "$ref": "#/$defs/expertiseList" },
        "ai": { "$ref": "#/$defs/expertiseList" }
      }
    },
    "llms": {
      "type": "object",
      "description": "How I use LLMs: patterns found in my own prompts (see https://dobrinov.github.io/jsonme/patterns-prompt.md).",
      "properties": {
        "source": { "type": "string", "description": "What the patterns were found in, e.g. \"2,145 prompts to Claude Code, Sep–Oct 2026\"." },
        "prompt": { "type": "string", "description": "URL of the prompt that found them. Defaults to the {me} patterns prompt." },
        "patterns": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": { "type": "string" },
              "goal": { "enum": ["planning", "building", "debugging", "reviewing", "designing", "research", "writing", "operating"] },
              "how": { "type": "string", "description": "What I do and when I use it." },
              "achieves": { "type": "string", "description": "What it gets me." },
              "example": { "type": "string", "description": "One real prompt, shortened." },
              "share": { "type": "number", "description": "Percentage of prompts that show this pattern." },
              "limit": { "type": "string", "description": "When it falls short." }
            }
          }
        },
        "gap": { "type": "string" }
      }
    },
    "work": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "startDate"],
        "properties": {
          "name": { "type": "string" },
          "position": { "type": "string" },
          "scope": { "type": "string", "description": "What changed under the same title, e.g. \"Reports to the CTO\". Shown as a step in the employer's growth path." },
          "url": { "type": "string" },
          "startDate": { "$ref": "#/$defs/date" },
          "endDate": { "$ref": "#/$defs/date" },
          "summary": { "type": "string" },
          "highlights": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" },
          "url": { "type": "string" },
          "startDate": { "$ref": "#/$defs/date" },
          "endDate": { "$ref": "#/$defs/date" },
          "pausedDate": { "$ref": "#/$defs/date", "description": "When work built by hand stopped." },
          "revivedDate": { "$ref": "#/$defs/date", "description": "When the product was picked up again with AI." },
          "vibecoded": { "type": "boolean", "description": "Built with AI from the start. Drawn with a star and a hatched bar." },
          "revival": { "type": "string", "description": "What was built after the revival." },
          "highlights": { "type": "array", "items": { "type": "string" } },
          "keywords": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "education": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "institution": { "type": "string" },
          "url": { "type": "string" },
          "area": { "type": "string" },
          "studyType": { "type": "string" },
          "startDate": { "$ref": "#/$defs/date" },
          "endDate": { "$ref": "#/$defs/date" }
        }
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "description": "A group, e.g. \"Can mentor\"." },
          "level": { "type": "string" },
          "keywords": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "meta": {
      "type": "object",
      "properties": {
        "me": {
          "type": "object",
          "properties": {
            "listed": { "type": "boolean", "description": "Include this profile in the {me} directory." },
            "lookingFor": { "type": "string" },
            "domains": { "type": "array", "items": { "type": "string" } },
            "aiEraStart": { "$ref": "#/$defs/date", "description": "Where the career line marks the AI era. Default 2023-01." },
            "repo": { "type": "string", "description": "Source repo URL, for \"Suggest an edit\" links. Filled by the Action." }
          }
        }
      }
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$",
      "description": "YYYY, YYYY-MM or YYYY-MM-DD. Leave endDate out while it is ongoing."
    },
    "expertiseList": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["name", "proof"],
        "properties": {
          "name": { "type": "string" },
          "proof": { "type": "string", "description": "One line of evidence, shown without a click." },
          "detail": { "type": "string" },
          "aiPractice": {
            "type": "object",
            "description": "For AI expertise: what you hand to AI, what you keep, how you check it.",
            "properties": {
              "delegated": { "type": "string" },
              "owned": { "type": "string" },
              "verifiedBy": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    }
  }
}
