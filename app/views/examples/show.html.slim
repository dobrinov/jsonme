.container
  = link_to '#' do
    = image_pack_tag 'created-with-me.svg', class: 'created-with'

  .profile-picture = image_tag @image

  h1.name = @name
  .description = @description

  = section 'Experience' do
    = timeline from: @experience_since_year do
      ul
        - @employments.each do |employment|
          li
            .period
              h3 = employment[:company][:name]
              aside
              = link_to nil, employment[:company][:website], target: '_blank', rel: "nofollow"
              div = format_period(employment[:period][:from], employment[:period][:to])

            .employment
              p = employment[:company][:summary]
              ul
                - employment[:roles].each do |role|
                  li.role
                    h4 = role[:title]
                    p = role[:summary]
                    aside Major achievements:
                    ul
                      - role[:major_achievements].each do |achievement|
                        li.achievement
                          h5 = achievement[:title]
                          p = achievement[:description]
                          ul
                            - achievement[:technologies].each do |technology|
                              li = technology

  = section 'Education' do
    = timeline from: @experience_since_year do
      ul
        - @education.each do |education|
          li
            .period
              h3 = education[:institution][:name]
              aside
              = link_to nil, education[:institution][:website], target: '_blank', rel: "nofollow"
              div = format_period(education[:period][:from], education[:period][:to])

            p = education[:summary]

  = section 'Location' do
    p = @location
