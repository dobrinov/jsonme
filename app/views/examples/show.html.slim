.container
  = link_to '#' do
    = image_pack_tag 'created-with-me.svg', class: 'created-with'

  .profile-picture = image_tag @cv.image

  h1.name = @cv.name
  .summary = @cv.summary

  = section 'Experience' do
    = timeline from: @cv.experience_from_year do
      ul
        - @cv.employments.each do |employment|
          li
            .period
              h3 = employment.employer.name
              aside
              = link_to nil, employment.employer.website, target: '_blank', rel: "nofollow"
              div = format_period(employment.period.from, employment.period.to)

            .employment
              p = employment.summary
              ul
                - employment.roles.each do |role|
                  li.role
                    h4 = role.title
                    p = role.summary
                    aside Major achievements:
                    ul
                      - role.achievements.each do |achievement|
                        li.achievement
                          h5 = achievement.title
                          p = achievement.summary
                          ul
                            - achievement.technologies.each do |technology|
                              li = technology

  = section 'Education' do
    = timeline from: @cv.training_from_year do
      ul
        - @cv.trainings.each do |training|
          li
            .period
              h3 = training.institution.name
              aside
              = link_to nil, training.institution.website, target: '_blank', rel: "nofollow"
              div = format_period(training.period.from, training.period.to)

            p = training.summary

  = section 'Location' do
    p = @cv.location
