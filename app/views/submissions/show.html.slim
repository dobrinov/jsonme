- content_for :url, request.original_url
- content_for :image, @resume.image
- content_for :title, "#{@resume.name} | Resume"
- content_for :description, @resume.summary

.centered-container
  = link_to root_path, target: 'blank' do
    = image_pack_tag 'created-with-me.svg', class: 'created-with'

  = link_to submission_path(method: @method, username: @username, format: 'pdf'), target: 'blank' do
    = image_pack_tag 'pdf.svg', class: 'pdf'

  #resume data-resume=@resume.payload
