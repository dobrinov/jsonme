.submission
  .centered-container
    h1 Getting started

    nav.tabs
      - submission_methods.each do |method|
        = link_to method.capitalize, new_submission_path(method: method), class: ('active' if method == @method)

    - if @method == 'text'
      = form_tag submissions_path(method: @method)
        .input
          = label_tag :payload, 'Résumé'
          = text_area_tag :payload, nil, placeholder: 'Paste your résumé in JSON format here'

        = submit_tag 'Generate résumé', class: 'button button-primary button-lg'

    - elsif @method == 'github'
      = form_tag submissions_path(method: @method)
        .input
          = label_tag :username, 'Username'
          = text_field_tag :username, nil, autocomplete: 'off', placeholder: 'Enter your Github username here'

        = submit_tag 'Generate résumé', class: 'button button-primary button-lg'

    - elsif @method == 'gitlab'
      = form_tag submissions_path(method: @method)
        .input
          = label_tag :username, 'Username'
          = text_field_tag :username, nil, autocomplete: 'off', placeholder: 'Enter your Gitlab username here'

        = submit_tag 'Generate résumé', class: 'button button-primary button-lg'

    - elsif @method == 'file'
      = form_tag submissions_path(method: @method), multipart: true
        .input
          = label_tag :username, 'Résumé'
          = file_field_tag :file

        = submit_tag 'Generate résumé', class: 'button button-primary button-lg'
