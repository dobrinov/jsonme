h1 New submission

ul
  - submission_methods.each do |method|
    li = link_to method, new_submission_path(method: method)

- if @method == 'text'
  h2 Text submission
  = form_tag submissions_path(method: @method)
    = text_area_tag :payload
    = submit_tag 'Generate'

- elsif @method == 'github'
  h2 Github submission
  = form_tag submissions_path(method: @method)
    = text_field_tag :username
    = submit_tag 'Generate'

- elsif @method == 'gitlab'
  h2 Gitlab submission
  = form_tag submissions_path(method: @method)
    = text_field_tag :username
    = submit_tag 'Generate'

- elsif @method == 'file'
  h2 File upload submission
  = form_tag submissions_path(method: @method), multipart: true
    = file_field_tag :file
    = submit_tag 'Generate'
