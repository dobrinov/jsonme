doctype html
html lang="en"
  head
    title = yield :title

    meta name="viewport" content="width=device-width,initial-scale=1"
    meta name="description" content="#{yield :description}"
    = csrf_meta_tags
    = csp_meta_tag
    = stylesheet_pack_tag 'application', media: 'all'
    = javascript_pack_tag 'application'

  body
    = yield
