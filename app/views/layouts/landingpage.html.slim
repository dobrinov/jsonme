doctype html
html lang="en"
  head
    title JsonMe - Your technical resume as JSON

    meta name="viewport" content="width=device-width,initial-scale=1"
    meta name="description" content="Technical resume generation tool. It could turn a JSON file into a nice looking web page or PDF."
    link rel="icon" href="/favicon.svg"

    = csp_meta_tag
    = stylesheet_pack_tag 'landingpage', media: 'all'
    = javascript_pack_tag 'landingpage'

  body
    = yield
